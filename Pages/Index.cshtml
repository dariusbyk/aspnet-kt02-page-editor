@page
@model TextEditor.Pages.IndexModel

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>Редактор текста</title>
    <script src="https://cdn.jsdelivr.net/npm/tinymce@8/tinymce.min.js"></script>
</head>
<body>
    <h1>Редактор текста</h1>

    <form method="post" onsubmit="saveEditor()">
        <p>
            <button type="button" onclick="formatText('Bold')">Жирный</button>
            <button type="button" onclick="formatText('Italic')">Курсив</button>
            <button type="button" onclick="formatText('Underline')">Подчёркнутый</button>
        </p>

        <textarea id="editor" name="Text" rows="15" cols="80">@Model.Text</textarea>

        <p>
            <button type="submit">Сохранить</button>
        </p>
    </form>

    <script src="~/js/editor.js"></script>
</body>
</html>
